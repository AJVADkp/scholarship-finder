# ==============================================================================
# ScholarSearch — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' for local development:
#    cp .env.example .env.local
# 2. Fill in the values with your actual service credentials.
# 3. NEVER commit '.env.local' or any file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Client & Server)
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (SERVER-SIDE ONLY - CRITICAL SECURITY RISK IF EXPOSED TO CLIENT)
# Used exclusively for admin authentication, background tasks, and seed scripts.
# NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Admin Portal Authentication
# ------------------------------------------------------------------------------
# High-entropy secret string used to sign and verify Admin JWT session cookies.
# Generate a strong 32+ byte string (e.g. run: openssl rand -base64 32)
ADMIN_JWT_SECRET=replace-with-a-secure-random-32-byte-secret-key

# ------------------------------------------------------------------------------
# 3. Application & Deployment URL
# ------------------------------------------------------------------------------
# Canonical URL of the deployment (used for OAuth redirects and metadata)
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
